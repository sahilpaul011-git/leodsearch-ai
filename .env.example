# Copy this file to .env.local for local development (vite reads it
# automatically). Never commit a real .env file -- .gitignore already
# excludes .env and .env.local.

# Once the Java backend is deployed (see backend/README.md), set this to
# its live URL. Leaving it unset keeps the site in demo mode with mock
# search results.
VITE_API_BASE_URL=
